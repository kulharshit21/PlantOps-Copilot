# PlantOps Copilot safe placeholders only.
# Copy to .env locally and replace with real values outside git.

# App
APP_ENV=development
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend public-safe values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend server-only values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_JWT_SECRET=replace-with-server-only-jwt-secret-if-using-local-verification
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# LLM providers
MISTRAL_API_KEY=replace-with-mistral-api-key
MISTRAL_MODEL=mistral-large-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma3
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Observability
OTEL_SERVICE_NAME=plantops-copilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_ENABLED=true

# ML / MLOps
MLFLOW_TRACKING_URI=file:./mlruns
MODEL_ARTIFACT_PATH=./ml/artifacts/failure_model.joblib
